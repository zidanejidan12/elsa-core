<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Mirrors elsa-studio 3.9.0 src/hosts/Elsa.Studio.Host.Server, using NuGet packages instead of project references. -->
    <PropertyGroup>
        <!-- .NET 10 only ships _framework/blazor.server.js when the project has a .razor file; this host has none. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elsa.Studio" VersionOverride="3.9.0" />
        <PackageReference Include="Elsa.Studio.Core.BlazorServer" VersionOverride="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.BlazorServer" VersionOverride="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.UI" VersionOverride="3.9.0" />
    </ItemGroup>

</Project>
